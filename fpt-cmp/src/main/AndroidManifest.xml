<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Khop defaultConfig trong build.gradle (Gradle van la nguon chinh khi merge manifest). -->
    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Tự khởi tạo SDK từ <meta-data>; authority theo applicationId để không trùng giữa các app. -->
        <provider
            android:name="vn.fpt.fis.cmp.consent.ConsentInitProvider"
            android:authorities="${applicationId}.cmp-init"
            android:exported="false" />
    </application>

</manifest>
