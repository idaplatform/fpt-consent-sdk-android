<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Khop defaultConfig trong build.gradle (Gradle van la nguon chinh khi merge manifest). -->
    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Chan backup du lieu SDK va chi cho phep HTTPS. App can gia tri khac phai khai
         tools:replace="android:allowBackup,android:usesCleartextTraffic" (xem README). -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <!-- Tự khởi tạo SDK từ <meta-data>; authority theo applicationId để không trùng giữa các app. -->
        <provider
            android:name="vn.fpt.fis.cmp.consent.ConsentInitProvider"
            android:authorities="${applicationId}.cmp-init"
            android:exported="false" />
    </application>

</manifest>
