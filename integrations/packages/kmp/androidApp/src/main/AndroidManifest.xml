<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khai bao cho scanner; build.gradle.kts van la nguon chinh va ghi de khi merge.
         AGP 9 chi cho phep the nay khi gradle.properties dat android.usesSdkInManifest.disallowed=false. -->
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />
    <!-- Khong cho backup du lieu app (visitor ID, quyet dinh consent) ra cloud / adb backup. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:label="CMP KMP Example"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
